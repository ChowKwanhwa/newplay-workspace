{
  "name": "newplay-library-preview",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": ["/files/*"], "not_found_handling": "404-page"},
  "r2_buckets": [{"binding": "FILES", "bucket_name": "replace-with-your-preview-bucket"}]
}
